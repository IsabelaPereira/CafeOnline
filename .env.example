# ============================================================
# DAS MATAS — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com os valores
# obtidos no painel do Supabase (Settings > API)
# ============================================================

# URL do projeto Supabase (ex: https://xyzabc.supabase.co)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave pública anon (safe para expor no frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# Onde encontrar:
#   Painel Supabase → Settings → API
#   "Project URL"       → VITE_SUPABASE_URL
#   "anon public"       → VITE_SUPABASE_ANON_KEY
# ============================================================
