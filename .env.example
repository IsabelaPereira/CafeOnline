# ============================================================
# DAS MATAS — Variáveis de Ambiente
# Copie para .env.local e preencha com os valores do Supabase
# ============================================================

# --- Supabase (Frontend — Settings > API) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Supabase CLI (CI/CD + dev local) ---
# Access Token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
# Project Ref: aparece na URL do dashboard (ex: abcdefghijklmnop)
SUPABASE_PROJECT_REF=abcdefghijklmnop
# Database Password: definida na criação do projeto
SUPABASE_DB_PASSWORD=sua-senha-do-banco

# --- Stripe (usado nas Edge Functions) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- VPS (usado no CI/CD — configurar nos GitHub Environments) ---
# VPS_HOST=SEU-IP-DO-VPS
# VPS_SSH_PORT=22
# VPS_USER=deploy
# VPS_SSH_KEY=(conteúdo da chave privada ed25519)
